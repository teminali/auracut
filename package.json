{
  "name": "kerf",
  "version": "1.11.0",
  "description": "Kerf — open-source AI video editor with full Model Context Protocol (MCP) integration",
  "author": {
    "name": "teminali",
    "email": "muhasibudigital@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/teminali/kerf",
  "repository": {
    "type": "git",
    "url": "https://github.com/teminali/kerf.git"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build:electron": "node electron/build.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "preview": "vite preview",
    "start": "npm run build:electron && electron .",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "release": "npm run build && electron-builder --publish always",
    "mcp:stdio": "ts-node src/mcp/cli.ts",
    "test": "vitest run",
    "verify": "python3 tools/run_all_suites.py",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.4.7",
    "immer": "^10.2.0",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "uiohook-napi": "^1.5.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "30.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "3.2.7"
  }
}
