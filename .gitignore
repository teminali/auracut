# Dependencies
# No trailing slash: a git worktree's node_modules is a SYMLINK to the
# main repo's (electron alone is 100MB+), and `node_modules/` matches a
# DIRECTORY only — git sees the symlink as a file and reports it
# untracked, so a lane's `git add -A` would commit an absolute path from
# somebody's laptop into the repo.
node_modules

# Build output
dist/
dist-electron/
release/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Local env — never commit signing credentials
.env
.env.local
*.p12
*.mobileprovision

# Public release distribution repo
releases-portal/

# Python bytecode from tools/
__pycache__/
*.pyc

# The approved design prototype is tracked, but its `uploads/` folder is
# 11MB of pasted screenshots that no page, stylesheet or script in it
# references. The .dc.html files and their CSS are the reference; these
# are not.
design-prototypes/*/uploads/
# Design Doc writes a preview thumbnail beside the prototype; it is a
# artifact of the editor, not part of the reference.
design-prototypes/*/.thumbnail
scratch/
apex_guardian/
